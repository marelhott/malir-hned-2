{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "crons": [
    { "path": "/api/cron/expire-offers", "schedule": "*/5 * * * *" }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/nabidka", "destination": "/nabidka.html" },
    { "source": "/zakazka", "destination": "/zakazka.html" },
    { "source": "/maliri/:name", "destination": "/malir.html" },
    { "source": "/maliri", "destination": "/malir.html" },
    { "source": "/malire", "destination": "/Maliri.html" },
    { "source": "/o-nas", "destination": "/O nas.html" }
  ]
}
