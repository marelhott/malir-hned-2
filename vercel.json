{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/maliri",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/maliri/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/nabidka",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/zakazka",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/expire-offers", "schedule": "*/5 * * * *" }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/nabidka", "destination": "/nabidka.html" },
    { "source": "/zakazka", "destination": "/zakazka.html" },
    { "source": "/maliri/:name", "destination": "/malir.html" },
    { "source": "/maliri", "destination": "/malir.html" },
    { "source": "/malire", "destination": "/Maliri.html" },
    { "source": "/o-nas", "destination": "/O nas.html" }
  ]
}
